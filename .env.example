# DorkOS Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Port convention:
#   Dev (source repo, pnpm dev):  6xxx ports (6242 server, 6241 client)
#   Production (npm install -g dorkos): 4xxx ports (4242 default)
# This lets dev and production run simultaneously on the same machine.

# Server port (production default: 4242)
DORKOS_PORT=6242

# Network address to listen on. Leave it alone unless you know you want DorkOS
# reachable from another machine — anything other than localhost needs a login
# turned on (`dorkos auth enable`) or the server refuses to start.
# DORKOS_HOST=localhost

# Dev-server previews inside DorkOS each open a port of their own, picked by the
# operating system. Pin the range if you run DorkOS in Docker or over `ssh -L`
# and want to forward those ports once. Inclusive, low to high.
# DORKOS_PREVIEW_PORT_RANGE=4243-4252

# Default working directory for new sessions
# DORKOS_DEFAULT_CWD=~/projects

# Directory access boundary (security: restricts file browsing to this path)
# DORKOS_BOUNDARY=~

# Log level: 0=Fatal, 1=Error, 2=Warn, 3=Info (default), 4=Debug, 5=Trace
# DORKOS_LOG_LEVEL=3

# Config/storage directory
# Default in production (or via CLI):  ~/.dork
# Default in dev (NODE_ENV != production): .temp/.dork  (project-local, gitignored)
# Override in any environment:
# DORK_HOME=/custom/path

# Scheduled tasks — the agent scheduler and its run history
# DORKOS_TASKS_ENABLED=true

# Relay inter-agent message bus — enabled by default; set false to disable
# DORKOS_RELAY_ENABLED=false

# A2A external gateway (requires DORKOS_RELAY_ENABLED=true)
# DORKOS_A2A_ENABLED=true

# The address other people's agents should use to reach yours. Defaults to
# http://{DORKOS_HOST}:{DORKOS_PORT}, which is only right when nothing sits in
# front of DorkOS — set it when you are behind a proxy or a tunnel. No query
# string, no #fragment, no user:password.
# DORKOS_PUBLIC_URL=https://agents.example.com

# How many requests a minute one address may make to the A2A endpoints, if the
# defaults (60 for calls, 300 for looking up an agent card) are wrong for you.
# DORKOS_A2A_RPC_RATE_LIMIT=60
# DORKOS_A2A_CARD_RATE_LIMIT=300

# How many sign-in attempts one address gets per 15 minutes. Raise it if you
# have locked yourself out; lower it if DorkOS is exposed.
# DORKOS_AUTH_SIGNIN_RATE_LIMIT=10

# Tunnel configuration (optional)
# TUNNEL_ENABLED=true
# NGROK_AUTHTOKEN=your-token-here
# TUNNEL_AUTH=user:password
# TUNNEL_DOMAIN=your-domain.ngrok-free.app
# TUNNEL_PORT=6242

# MCP Server — optional API key for external agent authentication
# Required when using tunnel (ngrok) for remote access.
# Generate a random key: openssl rand -hex 32
# MCP_API_KEY=your-api-key-here

# Local login (Better Auth) — optional; DorkOS runs with no login by default.
# When you enable login (`dorkos auth enable`), Better Auth signs sessions with
# this secret. Set it so sessions survive server restarts (without it a
# per-process fallback is used and users are logged out on every restart).
# Recommended for any exposed/production instance. Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=your-secret-here

# Turn off every bit of anonymous usage reporting, whatever the app's own
# setting says. DO_NOT_TRACK is the convention other tools honour too; the
# DorkOS-specific name does the same thing. Set either to 1 or true.
# DO_NOT_TRACK=1
# DORKOS_TELEMETRY_DISABLED=1

# Print what would be reported instead of sending it, so you can see for
# yourself what leaves the machine.
# DORKOS_TELEMETRY_DEBUG=1

# Send DorkOS traces to your own observability stack (Jaeger, Grafana Tempo,
# Honeycomb, ...). These are the standard OpenTelemetry names, and this is your
# data going to your tools — nothing here reaches DorkOS. DORKOS_OTEL_DEBUG
# writes the same traces to a file under your data directory instead.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=dorkos-server
# OTEL_SDK_DISABLED=true
# DORKOS_OTEL_DEBUG=false

# How long the activity feed keeps history, in days (default 30).
# DORKOS_ACTIVITY_RETENTION_DAYS=30

# Allow listening on a public address with no login. Only for a container that
# owns its own network boundary — it also switches off the request checks that
# assume DorkOS is reachable from this machine alone.
# DORKOS_ALLOW_INSECURE_BIND=false

# Where "connect this machine to your DorkOS account" points. Change it only to
# run against a local copy of the site.
# DORKOS_CLOUD_URL=https://dorkos.ai

# Self-hosted Nango, if you connect DorkOS to outside services through your own
# gateway. Both are needed together: without the encryption key Nango stores
# logins unencrypted, so DorkOS refuses to use it. Generate a 32-byte key:
# openssl rand -base64 32
# NANGO_BASE_URL=http://localhost:3003
# NANGO_ENCRYPTION_KEY=your-base64-key-here

# Vite dev server port (client only; proxies /api to DORKOS_PORT)
VITE_PORT=6241

# Marketing site analytics (apps/web only)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Where agents are told to read the DorkOS docs. A session whose directory hosts
# an agent gets handed {base}/llms.txt and {base}/docs, on every runtime, unless
# that agent has DorkOS knowledge switched off. Defaults to production, so leave
# it alone unless you are running the docs site yourself
# (pnpm --filter @dorkos/site dev) and want your agents reading the docs in this
# checkout rather than whatever shipped last. Must be an http:// or https:// URL
# with no query string, fragment, or user:password in it; the server refuses to
# start otherwise. (A password here would ride into every agent's prompt.)
# Note: this file is read by `pnpm dev` and `pnpm test`, but NOT by the built
# cockpit `pnpm dev:dogfood` starts on :4242 — `cli:dev` runs without the dotenv
# wrapper, so export the variable in your shell to reach that one.
# DORKOS_DOCS_BASE_URL=http://localhost:6244

# Override version for testing upgrade notifications in dev mode.
# When set, dev detection is bypassed and this value is used as the current version.
# Example: DORKOS_VERSION_OVERRIDE=0.1.0 makes the UI show upgrade available for any version > 0.1.0
# DORKOS_VERSION_OVERRIDE=

# Extra host names the /api Host guard accepts, comma-separated, no ports
# (e.g. dorkos.example.com,dorkos.internal). Only consulted in login-off mode,
# for a login-off instance sitting behind a reverse proxy.
# DORKOS_TRUSTED_HOSTS=

# Declared by a supervisor that owns the server's lifecycle. Set to "desktop"
# by the Electron shell so the admin restart/reset endpoints answer 409
# instead of exiting into a process nothing restarts. Leave unset otherwise.
# DORKOS_MANAGED_BY=

# Skip the per-data-directory single-instance lock. Escape hatch only; the
# lock is already inert under NODE_ENV=test.
# DORKOS_SKIP_INSTANCE_LOCK=false

# Index only what this server's own DORK_HOME holds — never your Claude Code,
# Codex or OpenCode history. FOR TEST HARNESSES, NOT FOR YOUR OWN INSTALL: the
# three e2e legs set it themselves because they run against a scratch data
# directory, which does not move ~/.claude and never isolated it (DOR-1551).
# Turning it on here would quietly narrow YOUR message search to rooms only —
# every transcript this box promises to cover would stop being findable.
# DORKOS_SEARCH_NO_EXTERNAL_HISTORY=false
