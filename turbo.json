{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalPassThroughEnv": [
    "VITEST_RETRY",
    "VITEST_MAX_WORKERS",
    "CLIENT_DIST_PATH",
    "DO_NOT_TRACK",
    "DORK_HOME",
    "DORKOS_A2A_ENABLED",
    "DORKOS_ACTIVITY_RETENTION_DAYS",
    "DORKOS_ALLOW_INSECURE_BIND",
    "DORKOS_BOUNDARY",
    "DORKOS_COCKPIT_PORT",
    "DORKOS_COCKPIT_VITE_PORT",
    "DORKOS_CORS_ORIGIN",
    "DORKOS_DEFAULT_CWD",
    "DORKOS_DOCS_BASE_URL",
    "DORKOS_E2E_NO_HMR",
    "DORKOS_LOG_LEVEL",
    "DORKOS_MANAGED_COMPOSIO_API_ORIGIN",
    "DORKOS_MANAGED_COMPOSIO_PROJECT_KEY",
    "DORKOS_MANAGED_CONNECTOR_AUTH_CONFIGS",
    "DORKOS_MANAGED_CONNECTOR_CALLBACK_ORIGIN",
    "DORKOS_MANAGED_CONNECTOR_WEBHOOK_SECRET",
    "DORKOS_MANAGED_CONNECTORS_ENABLED",
    "DORKOS_MANAGED_CONNECTORS_LIVE_READY",
    "DORKOS_MANAGED_BY",
    "DORKOS_MOCK_PORT",
    "DORKOS_MOCK_VITE_PORT",
    "DORKOS_PORT",
    "DORKOS_SEARCH_NO_EXTERNAL_HISTORY",
    "DORKOS_SITE_PORT",
    "DORKOS_SKIP_INSTANCE_LOCK",
    "DORKOS_TASKS_ENABLED",
    "DORKOS_TELEMETRY_DEBUG",
    "DORKOS_TELEMETRY_DISABLED",
    "DORKOS_TEST_RUNTIME",
    "DORKOS_TEST_RUNTIME_SECONDARY",
    "DORKOS_TRUSTED_HOSTS",
    "DORKOS_RELAY_ENABLED",
    "DORKOS_VERSION_OVERRIDE",
    "E2E_SITE",
    "MCP_API_KEY",
    "NGROK_AUTHTOKEN",
    "OTEL_*",
    "SITE_PORT",
    "TUNNEL_AUTH",
    "TUNNEL_DOMAIN",
    "TUNNEL_ENABLED",
    "TUNNEL_PORT",
    "VITE_PORT",
    "ELECTRON_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["generate:api-docs", "^build"],
      "outputs": ["dist/**", "dist-server/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NODE_ENV", "VITE_*", "!VITE_PORT", "NEXT_PUBLIC_*", "POSTHOG_*"]
    },
    "generate:api-docs": {
      "cache": true,
      "env": ["!VITE_PORT"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "@dorkos/harness#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/contributing/capabilities/harness-sync.md",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/scripts/vocab-gate/banned-terms.json",
        "$TURBO_ROOT$/scripts/check-vocab-gate.ts",
        "$TURBO_ROOT$/apps/server/src/services/harness/__tests__/**",
        "$TURBO_ROOT$/apps/server/src/routes/__tests__/harness.test.ts",
        "$TURBO_ROOT$/apps/server/src/services/rooms/repo/__tests__/room-worktree-manager.test.ts",
        "$TURBO_ROOT$/apps/server/src/services/runtimes/codex/__tests__/scan-skill-commands.test.ts",
        "$TURBO_ROOT$/apps/server/src/services/runtimes/codex/__tests__/skill-parity.test.ts",
        "$TURBO_ROOT$/packages/cli/src/__tests__/harness-sync*.test.ts",
        "$TURBO_ROOT$/apps/e2e/tests/harness/**",
        "$TURBO_ROOT$/.agents/harness.manifest.json",
        "$TURBO_ROOT$/meta/harness-smoke/**",
        "$TURBO_ROOT$/scripts/lib/space-server.mjs",
        "$TURBO_ROOT$/ci/space-server.env",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "@dorkos/server#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/contributing/capabilities/runtimes.md",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/scripts/lib/community-migration-id.mjs",
        "$TURBO_ROOT$/apps/space/package.json",
        "$TURBO_ROOT$/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/apps/space/tsconfig.json",
        "$TURBO_ROOT$/apps/space/tsconfig.build.json",
        "$TURBO_ROOT$/.github/workflows/publish-community.yml",
        "$TURBO_ROOT$/ci/space-server.env",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/apps/space/migrations/**",
        "$TURBO_ROOT$/apps/space/browser-tests/**",
        "$TURBO_ROOT$/apps/space/load/**",
        "$TURBO_ROOT$/apps/space/scripts/**",
        "$TURBO_ROOT$/apps/client/src/space/**",
        "$TURBO_ROOT$/apps/client/vite.space.config.ts",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/blog/**",
        "$TURBO_ROOT$/decisions/**",
        "$TURBO_ROOT$/changelog/unreleased/**",
        "$TURBO_ROOT$/contributing/**",
        "$TURBO_ROOT$/specs/community-tenancy-contract/**",
        "$TURBO_ROOT$/scripts/generate-community-release-manifest.ts",
        "$TURBO_ROOT$/apps/client/src/**",
        "$TURBO_ROOT$/apps/site/src/**",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/package.json",
        "$TURBO_ROOT$/apps/space/*.md",
        "$TURBO_ROOT$/apps/e2e/capture/config.ts",
        "$TURBO_ROOT$/apps/e2e/tests/rooms/canvas/room-follow.spec.ts",
        "$TURBO_ROOT$/apps/e2e/tests/connections/community-switching-proof.spec.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/scripts/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/*.md",
        "$TURBO_ROOT$/packages/*/*.{ts,mts,mjs,cjs,js}",
        "$TURBO_ROOT$/packages/db/drizzle/**"
      ]
    },
    "@dorkos/server#typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/scripts/lib/community-migration-id.mjs",
        "$TURBO_ROOT$/apps/space/browser-tests/**",
        "$TURBO_ROOT$/apps/space/load/**",
        "$TURBO_ROOT$/apps/space/scripts/**",
        "$TURBO_ROOT$/apps/client/src/space/**",
        "$TURBO_ROOT$/apps/client/vite.space.config.ts"
      ]
    },
    "@dorkos/community#build": {
      "dependsOn": ["generate:api-docs", "^build"],
      "outputs": ["dist/**", "dist-server/**"],
      "env": ["NODE_ENV", "VITE_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/spaces/**",
        "$TURBO_ROOT$/apps/client/src/space/**",
        "$TURBO_ROOT$/apps/client/vite.space.config.ts"
      ]
    },
    "@dorkos/community#typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/spaces/**",
        "$TURBO_ROOT$/apps/client/src/space/**",
        "$TURBO_ROOT$/apps/client/vite.space.config.ts"
      ]
    },
    "@dorkos/community#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/spaces/**",
        "$TURBO_ROOT$/apps/client/src/space/**",
        "$TURBO_ROOT$/apps/client/vite.space.config.ts"
      ]
    },
    "@dorkos/test-utils#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/contributing/capabilities/chat.md",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/apps/client/src/**/*.test.ts",
        "$TURBO_ROOT$/apps/client/src/**/*.test.tsx",
        "$TURBO_ROOT$/apps/server/src/**/*.test.ts",
        "$TURBO_ROOT$/apps/e2e/tests/**",
        "$TURBO_ROOT$/packages/*/src/**/*.test.ts",
        "$TURBO_ROOT$/packages/*/src/**/*.test.tsx",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "@dorkos/ci-steward#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/ci/**",
        "$TURBO_ROOT$/lefthook.yml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.claude/settings.json",
        "$TURBO_ROOT$/.claude/hooks/**",
        "$TURBO_ROOT$/scripts/**",
        "!$TURBO_ROOT$/scripts/node_modules/**",
        "$TURBO_ROOT$/apps/e2e/playwright.config.ts",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "dorkos#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/e2e/community-two-desktop/**"]
    },
    "@dorkos/marketplace#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/marketplace/fixtures/valid-shape/**"
      ]
    },
    "@dorkos/evals#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/turbo.json"]
    },
    "@dorkos/client#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/apps/design-system/src/**",
        "$TURBO_ROOT$/apps/site/package.json",
        "$TURBO_ROOT$/apps/site/eslint.config.mjs",
        "$TURBO_ROOT$/apps/site/src/lib/rate-limit/fixed-window.ts",
        "$TURBO_ROOT$/packages/eslint-config/*.{js,mjs,cjs,json}"
      ]
    },
    "@dorkos/site#test": {
      "dependsOn": [
        "^build",
        "@dorkos/relay#build",
        "@dorkos/extension-api#build",
        "@dorkos/keep-awake#build"
      ],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/blog/**",
        "$TURBO_ROOT$/scripts/lib/code-only.mjs",
        "$TURBO_ROOT$/apps/server/src/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "@dorkos/server#lint": {
      "dependsOn": ["^lint"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/space/package.json"]
    },
    "pack": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
        "CI",
        "PWDEBUG",
        "ANTHROPIC_API_KEY"
      ]
    },
    "e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["src/schema/**/*.ts", "drizzle.config.ts"],
      "outputs": ["drizzle/**"],
      "cache": true
    },
    "db:check": {
      "inputs": ["src/schema/**/*.ts", "drizzle.config.ts"],
      "cache": false
    },
    "dist": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false,
      "env": [
        "APPLE_API_KEY",
        "APPLE_API_KEY_ID",
        "APPLE_API_ISSUER",
        "CSC_LINK",
        "CSC_KEY_PASSWORD",
        "GH_TOKEN"
      ]
    }
  }
}
