{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "globalPassThroughEnv": [
    "VITEST_RETRY",
    "CLIENT_DIST_PATH",
    "DO_NOT_TRACK",
    "DORK_HOME",
    "DORKOS_A2A_ENABLED",
    "DORKOS_ACTIVITY_RETENTION_DAYS",
    "DORKOS_ALLOW_INSECURE_BIND",
    "DORKOS_BOUNDARY",
    "DORKOS_COCKPIT_PORT",
    "DORKOS_COCKPIT_VITE_PORT",
    "DORKOS_CORS_ORIGIN",
    "DORKOS_DEFAULT_CWD",
    "DORKOS_DOCS_BASE_URL",
    "DORKOS_E2E_NO_HMR",
    "DORKOS_LOG_LEVEL",
    "DORKOS_MANAGED_BY",
    "DORKOS_MOCK_PORT",
    "DORKOS_MOCK_VITE_PORT",
    "DORKOS_PORT",
    "DORKOS_SEARCH_NO_EXTERNAL_HISTORY",
    "DORKOS_SITE_PORT",
    "DORKOS_SKIP_INSTANCE_LOCK",
    "DORKOS_TASKS_ENABLED",
    "DORKOS_TELEMETRY_DEBUG",
    "DORKOS_TELEMETRY_DISABLED",
    "DORKOS_TEST_RUNTIME",
    "DORKOS_TEST_RUNTIME_SECONDARY",
    "DORKOS_TRUSTED_HOSTS",
    "DORKOS_RELAY_ENABLED",
    "DORKOS_VERSION_OVERRIDE",
    "E2E_SITE",
    "MCP_API_KEY",
    "NGROK_AUTHTOKEN",
    "OTEL_*",
    "SITE_PORT",
    "TUNNEL_AUTH",
    "TUNNEL_DOMAIN",
    "TUNNEL_ENABLED",
    "TUNNEL_PORT",
    "VITE_PORT",
    "ELECTRON_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["generate:api-docs", "^build"],
      "outputs": ["dist/**", "dist-server/**", "dist-obsidian/**", ".next/**"],
      "env": ["NODE_ENV", "VITE_*", "NEXT_PUBLIC_*", "POSTHOG_*"]
    },
    "generate:api-docs": {
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "pack": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
        "CI",
        "PWDEBUG",
        "ANTHROPIC_API_KEY"
      ]
    },
    "e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["src/schema/**/*.ts", "drizzle.config.ts"],
      "outputs": ["drizzle/**"],
      "cache": true
    },
    "db:check": {
      "inputs": ["src/schema/**/*.ts", "drizzle.config.ts"],
      "cache": false
    },
    "dist": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false,
      "env": [
        "APPLE_API_KEY",
        "APPLE_API_KEY_ID",
        "APPLE_API_ISSUER",
        "CSC_LINK",
        "CSC_KEY_PASSWORD",
        "GH_TOKEN"
      ]
    }
  }
}
