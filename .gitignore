# Dependencies
node_modules/

# pnpm workspace bin symlinks
packages/cli/bin/

# Bundled core-extension source, copied by packages/cli/scripts/build.ts
# (DOR-245) to sit alongside dist/ where the bundled server's CORE_SOURCE_DIR
# resolution expects it. Regenerated by every `pnpm --filter dorkos build`.
packages/cli/core-extensions/

# Same as above, copied by apps/desktop/scripts/build-server.ts for the
# desktop app's bundled server. Regenerated by every
# `pnpm --filter @dorkos/desktop build`.
apps/desktop/core-extensions/

# Prebuilt SQLite add-ons the Obsidian plugin build fetches once and reuses.
# Binaries, per Electron ABI — downloaded from better-sqlite3's own releases,
# never committed.
apps/obsidian-plugin/.native/

# Build outputs
dist/
dist-server/
dist-obsidian/
*.tsbuildinfo
*.tgz
.source/

# Generated docs (openapi.json is committed for Vercel builds)

# Turborepo
.turbo/

# Test & coverage
coverage/
test-results/
# Agent fixtures the e2e seed routes write under the boundary root
# (`tmp/dorkos-e2e-agent`, `tmp/dorkos-e2e-oauth-agent` in routes/test-control.ts)
tmp/

# Capture media library — raw recordings are heavy and regenerable; only the
# layout README is committed (see apps/e2e/capture/library/README.md)
apps/e2e/capture/library/*
!apps/e2e/capture/library/README.md

# Where the process phase parks the previous published set while it rewrites it
# (`publishWithRollback` in apps/e2e/capture/process.ts), one directory per pid.
# Removed once its contents are safely back; a hard kill, or a restore that
# could not finish, deliberately leaves one standing — it may be the only copy
# of that media, and it must not read as 30 MB of untracked files when it is.
apps/site/public/product/.publish-backup-*/

# The browser-suite manifest: every run rewrites lastRun/run/pass counts and
# reformats the file, so no legitimate action could ever leave it clean when
# tracked — a standing trap two branches had to hand-restore before committing
# (DOR-726). `apps/e2e/reporters/manifest-reporter.ts` keeps writing it as a
# local artifact; nothing in CI reads or uploads it.
apps/e2e/manifest.json

# Environment & secrets
.env
.mcp.json

# Tooling caches
.eslintcache
*.timestamp-*
.playwright-mcp

# yalc — local package co-dev overlay (e.g. in-flight blintz changes)
.yalc/
yalc.lock

# OS files
.DS_Store

# Project working files
.plan
.scratch/
.temp
# Eval run output (transcripts + results.json) — CI uploads these as artifacts
.evals-runs/
# Transient lock that suppresses the changelog-populator post-commit hook
.claude/.changelog-populator.lock
.vercel
.worktrees/
.superpowers/
mockups/background-agent-indicator.html
mockups/running-figure-drafts.html
mockups/running-figure-final.html
mockups/running-figure-transitions.html
mockups/running-figure-v2.html
mockups/running-figure-v3.html
.dork/visual-companion/
.dork/flow/
# This checkout's own agent memory (DOR-632). `.dork/agent.json` at the repo
# root makes every session here an agent, so the memory file gets written and
# READ ALOUD in this repo — it is this machine's notes, never the project's.
.dork/MEMORY.md
# Marketplace-installed plugins + their ephemeral harness projections (DOR-173).
# Kept in sync with EPHEMERAL_GITIGNORE_PATTERNS in @dorkos/harness.
# (Generated command wrappers under .claude/commands/<pkg>/ are kept out of git
# by a self-ignoring .gitignore the engine writes inside each wrapper dir, so a
# static rule here would not swallow authored .claude/commands/<ns>/ dirs.)
.dork/plugins/
.agents/skills/*__*
.claude/skills/*__*
.claude/settings.local.json
.codex/hooks.json
.cursor/hooks.json
.github/hooks/copilot-hooks.json
# Transient install-transaction target backups (ADR-0304): reaped on success,
# left on disk only after a hard crash mid-activate.
*.dorkos-bak-*
vitest-shard-report.json
# Written by scripts/vitest-flake-reporter.ts into each package it runs in, and
# read by the merge-queue leg of .github/workflows/test.yml. A local artifact
# like the one above; nothing commits it.
vitest-flake-report.json
# The throwaway fixture tree scripts/__tests__/vitest-flake-reporter.test.ts
# generates under scripts/ (it has to live inside the repo so the fixture's
# `import 'vitest'` resolves). Removed in afterAll — this line is what stops an
# interrupted run leaving a deliberately-failing spec file behind.
scripts/.flake-fixture-*/
# Entity slices written into the source tree by the cross-entity DAG guard
# (apps/client/__tests__/entity-dag-lint.test.ts). They have to live under
# `entities/` because the lint rule they exercise is scoped to that path, and
# they are removed in `afterAll` — this line is what stops an interrupted run
# from leaving a committable landmine behind. ESLint does not read .gitignore,
# so the fixture is still linted.
apps/client/src/layers/entities/__dag-fixture-*__/
# Same arrangement, for the slice-encapsulation guard
# (apps/client/__tests__/cross-slice-import-lint.test.ts). Its fixtures have to
# live inside `src/layers/` because the rule derives a file's slice from that
# file's own path; anywhere else the rule skips them and every assertion passes
# vacuously.
apps/client/src/layers/*/__slice-fixture-*__/
