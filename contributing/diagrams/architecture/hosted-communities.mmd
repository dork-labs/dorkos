flowchart TB
  accTitle: Spaces and optional Cloud space management
  accDescr: The local app implements start and move requests to Cloud. Space management and ordinary space participation have separate authority. Move archives go from the local server directly to the returned space upload target. Imports and optional configured OIDC are implemented. Server takedown and evidence operations are explicit exceptions to ordinary content access. Contract support does not establish space-management deployment availability.

  app["<b>Your DorkOS</b><br/><span class='d'>Start and move dialogs · agents run here</span>"]
  cloud["<b>Cloud space management · optional</b><br/><span class='d'>Public contract · availability checked separately</span>"]
  browser["<b>Space website</b>"]
  issuer["<b>OIDC issuer · optional</b>"]

  subgraph host["Space server · runs on its own"]
    admin["<b>Administration API</b><br/><span class='d'>Scoped keys · lifecycle, limits, usage, holds<br/>Takedown and evidence · owner replacement</span>"]
    content["<b>Tenant content API</b><br/><span class='d'>Membership · channels · posts · files</span>"]
    upload["<b>Import target</b><br/><span class='d'>Archive upload, in parts</span>"]
    auth["<b>Server-wide sign-in</b><br/><span class='d'>Per-space membership</span>"]
    data[("<b>Postgres and blobs</b><br/><span class='d'>The space server owns content</span>")]
    admin -->|"scoped operations"| data
    content --> data
    upload -->|"restore people and agents inactive<br/><span class='d'>credentials revoked · one-time owner claim</span>"| data
    auth -->|"authenticate, check membership"| content
  end

  browser <-->|"HTTP, SSE"| content
  app <-->|"pairing · HTTP and SSE"| content
  app -->|"start, poll, claim, move"| cloud
  app -->|"archive, uploaded directly"| upload
  cloud -.->|"space management<br/><span class='d'>contract · scoped server key</span>"| admin
  issuer <-->|"OIDC sign-in"| auth
  journal["<b>Erasure journal</b><br/><span class='d'>IDs only · a copy kept off the server<br/>Reapplied to the store after a restore</span>"]
  admin -->|"export erasure records"| journal

  classDef cloud fill:#fff5e4,stroke:#a87720,color:#49320c
  classDef external fill:#ffffff,stroke:#8a9bab,color:#3b4a58
  class cloud cloud
  class issuer external
