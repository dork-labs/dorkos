flowchart TB
  accTitle: Marketplace discovery, installation, and activation
  accDescr: Source registries and repositories supply packages. The website browses them. Local installation validates and previews changes, performs a file transaction, then activates code or projects agent assets through Harness Sync.

  repo["<b>Marketplace sources</b><br/><span class='d'>Dork Labs and third-party repositories</span>"]
  site["<b>dorkos.ai marketplace</b><br/><span class='d'>Discovery and README pages</span>"]
  user["<b>App, CLI or MCP caller</b>"]
  installer["<b>Installer</b><br/><span class='d'>Resolve · stage once · validate · preview<br/>Approval binds the staged copy</span>"]
  txn["<b>File transaction</b><br/><span class='d'>Stage · back up · rename · restore on failure</span>"]
  disk[("<b>Installed packages</b><br/><span class='d'>User, project or agent scope</span>")]
  activate["<b>Activation by package type</b><br/><span class='d'>Extensions · messaging · agents · shapes</span>"]
  restore["<b>Rollback</b><br/><span class='d'>Undo this install only<br/>Keep existing secrets and agent links</span>"]
  harness["<b>Harness Sync</b><br/><span class='d'>Projects skills, commands, hooks and MCP config</span>"]
  runtime["<b>Files each harness reads</b><br/><span class='d'>Claude Code · Codex · OpenCode</span>"]
  telemetry["<b>Install telemetry</b><br/><span class='d'>Reporting only, never delivery</span>"]

  repo -->|"registry, READMEs"| site
  repo -->|"HTTPS, Git, npm, local"| installer
  user -->|"API or MCP tool"| installer
  installer -->|"authorized install"| txn
  txn --> disk
  disk --> activate
  activate -->|"messaging failure, reinstall"| restore
  disk --> harness
  harness --> runtime
  installer -->|"outcome, if telemetry is on"| telemetry

  classDef external fill:#ffffff,stroke:#8a9bab,color:#3b4a58
  class repo external
