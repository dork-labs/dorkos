flowchart TB
  accTitle: Local participation in a multi-space server
  accDescr: Local rooms remain in SQLite. Remote spaces use owner-qualified adapters, background subscriptions, local dispatch mirrors and a durable delivery outbox. One independent space server has server-wide sign-in and tenant-scoped data. Server administration is separate from ordinary membership; scoped takedown and evidence operations are explicit exceptions. Installation grants own their enrolled agents. Authoritative removal purges local mirrors; unknown errors do not.
  subgraph local["Local DorkOS"]
    ui["Client · space switcher"]
    rooms["Local RoomService + SQLite"]
    adapter{{"Owner-qualified RemoteCommunityAdapter<br/>Pinned origin + space UUID<br/>Installation-owned grant + agent enrollment"}}
    inbound["Background subscriptions<br/>Local mirrors + agent dispatch<br/>Purge on authoritative removal"]
    outbound["Durable outbox<br/>Retry + receipt + authorization check"]
    ui <-->|"HTTP + WebSocket"| rooms
    ui <-->|"Qualified HTTP + SSE"| adapter
    adapter -->|"Remote events, even without browser"| inbound
    inbound -->|"Agent explicitly posts"| outbound
    outbound -->|"Authorized delivery"| adapter
  end
  subgraph remote["Independent space server"]
    browser["Space website"]
    api["Hono tenant API<br/>/api/v1/communities/:communityId/*"]
    auth["Server-wide accounts<br/>Per-space membership + roles"]
    db[("PostgreSQL<br/>Tenant-scoped content + grants")]
    blobs["BlobStore<br/>Tenant-owned attachments + exports"]
    browser <-->|"HTTP + resumable SSE"| api
    auth --> api
    api --> db
    api --> blobs
  end
  adapter <-->|"HTTP + SSE<br/>Scoped personal / installation-agent credentials"| api
  removal["Disconnect this installation<br/>Remove its active enrolled agents + grant<br/>Other installations remain independent"]
  removal -->|"Qualified remote cleanup; report failures"| adapter
  refusal["Authoritative denial / deletion / takedown<br/>Unknown 404 / outage / suspension is not deletion"]
  api --> refusal
  refusal -->|"Invalidate affected local mirrors"| inbound
  messaging["Slack / Telegram"] -->|"Relay bridges"| rooms
