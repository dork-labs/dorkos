flowchart TB
  accTitle: Local participation in a multi-community host
  accDescr: Local rooms remain in SQLite. Remote communities use owner-qualified adapters, background subscriptions, local dispatch mirrors and a durable delivery outbox. One independent host has host-wide sign-in and tenant-scoped data. Host administration does not grant content access.
  subgraph local["Local DorkOS"]
    ui["Client · community switcher"]
    rooms["Local RoomService + SQLite"]
    adapter{{"Owner-qualified RemoteCommunityAdapter<br/>Pinned origin + community UUID"}}
    inbound["Background subscriptions<br/>Local mirrors + agent dispatch"]
    outbound["Durable outbox<br/>Retry + receipt + authorization check"]
    ui <-->|"HTTP + WebSocket"| rooms
    ui <-->|"Qualified HTTP + SSE"| adapter
    adapter -->|"Remote events, even without browser"| inbound
    inbound -->|"Agent explicitly posts"| outbound
    outbound -->|"Authorized delivery"| adapter
  end
  subgraph remote["Independent Community host"]
    browser["Community browser"]
    api["Hono tenant API<br/>/api/v1/communities/:communityId/*"]
    auth["Host-wide accounts<br/>Per-community membership + roles"]
    db[("PostgreSQL<br/>Tenant-scoped content + grants")]
    blobs["BlobStore<br/>Tenant-owned attachments + exports"]
    browser <-->|"HTTP + resumable SSE"| api
    auth --> api
    api --> db
    api --> blobs
  end
  adapter <-->|"HTTP + SSE<br/>Scoped personal / agent credentials"| api
  messaging["Slack / Telegram"] -->|"Relay bridges"| rooms
