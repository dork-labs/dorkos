{
  "theme": "base",
  "layout": "elk",
  "deterministicIds": true,
  "deterministicIDSeed": "dorkos-architecture",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#edf3fa",
    "primaryTextColor": "#183047",
    "primaryBorderColor": "#46709b",
    "lineColor": "#607080",
    "secondaryColor": "#f3f6f9",
    "tertiaryColor": "#ffffff",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#becbd7",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#edf3fa",
    "actorBorder": "#46709b",
    "actorTextColor": "#183047",
    "signalColor": "#43586d",
    "signalTextColor": "#183047",
    "noteBkgColor": "#fff5e4",
    "noteBorderColor": "#b89559",
    "noteTextColor": "#49320c"
  },
  "themeCSS": ".nodeLabel b{font-size:16px;font-weight:700;} .nodeLabel .d{display:block;margin-top:3px;font-size:13px;line-height:1.3;font-weight:400;opacity:0.82;} .cluster-label span{font-size:13px;font-weight:700;color:#46709b;} .cluster rect{rx:10px;ry:10px;} .edgeLabel, .edgeLabel p{font-size:13px;line-height:1.25;color:#3b4a58;} .edgeLabel p{padding:1px 5px;border-radius:4px;} .edgeLabel .d{display:block;font-size:12px;opacity:0.8;} .node rect, .node polygon{rx:6px;ry:6px;} .flowchart-link{stroke-width:1.5px;} .marker{fill:#607080;stroke:#607080;}",
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "nodeSpacing": 40,
    "rankSpacing": 60,
    "padding": 14,
    "diagramPadding": 12,
    "subGraphTitleMargin": {
      "top": 6,
      "bottom": 10
    },
    "wrappingWidth": 280
  },
  "elk": {
    "mergeEdges": false,
    "nodePlacementStrategy": "BRANDES_KOEPF"
  },
  "sequence": {
    "useMaxWidth": true,
    "wrap": true,
    "actorMargin": 40,
    "messageMargin": 34,
    "actorFontWeight": 700,
    "noteMargin": 12
  }
}
