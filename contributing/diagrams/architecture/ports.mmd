flowchart LR
  accTitle: DorkOS replaceable interfaces
  accDescr: Each row names a caller, its port, and implementations. A port is a code boundary, not necessarily a network boundary. Dashed edges mark unwired or future use.
  ui["React client"] --> transport{{"Transport"}}
  transport --> http["HttpTransport<br/>HTTP + WebSocket → Express"]
  transport --> direct["DirectTransport<br/>In-process subset · Obsidian preview"]
  dispatch["Session dispatcher"] --> agent{{"AgentRuntime"}}
  agent --> runtimes["Claude Code / Codex SDKs<br/>OpenCode HTTP + SSE sidecar"]
  accounts["Account actions"] --> connector{{"ConnectorProvider"}}
  connector --> backends["Composio · Nango · raw MCP<br/>Managed Cloud backend"]
  rooms["Community registry"] --> community{{"CommunityAdapter"}}
  community --> local["LocalCommunityAdapter<br/>Wraps local RoomService"]
  community -.-> remote["Buzz implementation: not wired<br/>Remote Community: in development"]
  notes["Agent memory"] --> memory{{"MemoryProvider"}}
  memory --> files["Built-in MEMORY.md store<br/>Optional registered backends"]
  relay["Relay message bus"] --> messaging{{"RelayAdapter"}}
  messaging --> channels["Messaging platforms / agent delivery<br/>Protocol depends on implementation"]
  classDef port fill:#e7f1eb,stroke:#427a55,color:#183f26
  class transport,agent,connector,community,memory,messaging port
