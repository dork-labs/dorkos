flowchart TB
  accTitle: Projects, extensions, and starting agent work
  accDescr: Project identity resolves to a git main checkout, while workspaces are execution checkouts. One running extension can reach several permitted projects. Approval of code or trust in its source is separate from per-project settings. Activity decisions and a bounded launch door preserve project account eligibility and session provenance.

  folders["<b>Sessions · agents · installs · workspaces</b>"]
  projects["<b>Project registry</b><br/><span class='d'>Stable name for a git main checkout<br/>Worktrees resolve to the same project</span>"]
  reported["<b>Extension-reported roots</b><br/><span class='d'>Visible, not scanned</span>"]
  workspace["<b>Workspace checkout</b><br/><span class='d'>Isolation for a run · not a new project</span>"]
  code["<b>Discovered extension code</b>"]
  approval["<b>A person approves a copy or trusts a source</b><br/><span class='d'>Activity inbox or Settings<br/>Trusting code is not enabling it</span>"]
  extension["<b>One running extension</b><br/><span class='d'>Several permitted projects</span>"]
  settings["<b>Per-project settings</b><br/><span class='d'>Enable work, separately from trusting code</span>"]
  inbox["<b>Activity inbox</b><br/><span class='d'>Core owns the deadline, the answer and the history</span>"]
  start["<b>One launch door</b><br/><span class='d'>Project visibility · account eligibility<br/>Shared rate and running limits</span>"]
  session["<b>New chat in the project root</b><br/><span class='d'>First prompt sent · origin recorded<br/>The current chat is unchanged</span>"]

  folders --> projects
  reported -->|"until core sees them"| projects
  projects --> workspace
  code --> approval
  approval -->|"approved loading policy"| extension
  projects -->|"permitted project context"| extension
  extension <-->|"project-scoped configuration"| settings
  extension <-->|"raise, answer, resolve"| inbox
  extension -->|"a person's action or a server request"| start
  projects -->|"resolve, enforce visibility"| start
  start -->|"eligibility rechecked at launch"| session
