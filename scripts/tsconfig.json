{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // `__tests__/vitest-projects.test.ts` imports the root `vitest.config.ts` by
    // path so it asserts against the real project list rather than a copy of it.
    // Safe with `noEmit`: nothing is written, so there is no emitted specifier
    // left pointing at a `.ts` file.
    "allowImportingTsExtensions": true
  },
  "include": [
    "q3-contention/**/*.ts",
    "__tests__/**/*.ts",
    "vitest.config.ts",
    "check-vocab-gate.ts",
    "vitest-flake-reporter.ts"
  ]
}
