{
  "name": "@dorkos/community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist-server/main.js",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts --reporter=default --reporter=json --outputFile.json=vitest-pg-report.json && node scripts/assert-pg-tests.mjs",
    "test:s3": "vitest run --config vitest.s3.config.ts",
    "test:browser": "pnpm build && node -e \"require('node:fs').rmSync('browser-report.json',{force:true})\" && playwright test --config playwright.config.ts && tsx scripts/assert-browser-tests.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@dorkos/shared": "workspace:*",
    "@hono/node-server": "1.19.15",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.13.8",
    "lucide-react": "1.47.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/test-utils": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.11",
    "@dorkos/db": "workspace:*"
  }
}
