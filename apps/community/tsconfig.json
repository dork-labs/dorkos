{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "scripts/**/*.ts",
    "browser-tests/**/*.ts",
    "acceptance/**/*.ts",
    "playwright.config.ts"
  ]
}
