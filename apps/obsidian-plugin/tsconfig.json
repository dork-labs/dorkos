{
  "extends": "@dorkos/typescript-config/react.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../client/src/*"]
    }
  },
  // "*.ts" — the package root, non-recursively — covers vite.config.ts and
  // vitest.config.ts, which were checked by NOTHING before DOR-1472. That
  // mattered because vite.config.ts had just grown an import reaching OUT of
  // this package (`../client/vite-define.js`, the same cross-package `define`
  // seam DOR-1471 covered for the desktop shell): a broken one there is a bare
  // identifier in the shipped bundle, not a build error, and neither ESLint
  // nor `vite build` itself would have caught a type mismatch across that
  // seam. Named as a pattern, not by filename, so the next root config added
  // here is covered the day it lands instead of the day someone remembers
  // this file.
  "include": ["src/**/*", "build-plugins/**/*", "scripts/**/*", "../client/src/**/*", "*.ts"],
  // The last two mirror apps/client/tsconfig.json's own fixture-glob excludes
  // (DOR-1821), rewritten with the ../client/ prefix this config's `include`
  // and `paths` already use to reach that tree. Those fixtures are resident in
  // src/layers/ for the whole client test run, and the include above already
  // reaches all of ../client/src — so without these two, `tsc --noEmit` exits
  // 2 on three errors nobody wrote whenever this typecheck overlaps that run:
  // the pre-push gate and `pnpm verify` both do (DOR-1881). Pinned by
  // scripts/__tests__/obsidian-tsconfig-fixture-exclude.test.ts, so the two
  // files cannot drift apart again.
  "exclude": [
    "node_modules",
    "dist",
    "../client/src/main.tsx",
    "../client/src/**/__tests__/**",
    "../client/src/layers/entities/__dag-fixture-*__/**",
    "../client/src/layers/*/__slice-fixture-*__/**"
  ]
}
