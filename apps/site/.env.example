# Database — Neon Postgres. The site uses @neondatabase/serverless, so a SQLite
# `file:` URL will NOT work; DATABASE_URL must be a Postgres connection string.
# Easiest local setup: link the project, then `vercel env pull apps/site/.env.local`
# to fetch the Neon integration's connection string. Or set one manually (use a
# Neon *dev branch* for local work, never your production database):
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Authentication — Better Auth, the DorkOS *account* cloud identity (P2).
# For production, generate a secure 32+ character secret:
#   Option 1: openssl rand -base64 32
#   Option 2: npx @better-auth/cli secret
# Docs: https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET="dev-only-insecure-secret-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Social sign-in (GitHub + Google). Leave empty to disable a provider; the
# providers still register but won't complete OAuth without credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Managed connections start off. Enable them first in a protected preview and
# test account sign-in, one safe read, and revocation. Then enable production
# and repeat that smoke test. Set LIVE_READY back to 0 if either test fails.
DORKOS_MANAGED_CONNECTORS_ENABLED="0"
DORKOS_MANAGED_CONNECTORS_LIVE_READY="0"
# Server-only Composio project key for the hosted DorkOS tenant. Never use a
# user account key here.
# DORKOS_MANAGED_COMPOSIO_PROJECT_KEY="project-key"
# Leave unset for Composio's production API. Tests may point this at a local
# deterministic provider.
# DORKOS_MANAGED_COMPOSIO_API_ORIGIN="http://127.0.0.1:4257"
# Canonical HTTPS site origin used for the fixed account callback. Localhost is
# allowed for development. Paths, query strings, and embedded credentials fail.
DORKOS_MANAGED_CONNECTOR_CALLBACK_ORIGIN="http://localhost:3000"
# JSON object mapping each toolkit slug to its server-owned auth configuration.
DORKOS_MANAGED_CONNECTOR_AUTH_CONFIGS='{}'
# Reserved for managed event delivery. Setting it does not enable events until
# the event ingress and production smoke ship in their own phase.
# DORKOS_MANAGED_CONNECTOR_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Resend — transactional email for DorkOS account verification + password reset.
# Required to actually send email; sending throws a clear error when unset.
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=""
RESEND_FROM="DorkOS <onboarding@resend.dev>"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostHog Analytics — leave the key empty to keep analytics fully off (the site
# then makes zero PostHog requests). Get a project key from your PostHog project
# settings. HOST is the region ingest host: https://us.i.posthog.com or
# https://eu.i.posthog.com — it drives both the SDK and the /hub reverse
# proxy in next.config.ts. Event names + funnel docs: src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Linear feedback intake (POST /api/feedback) — leave LINEAR_API_KEY empty to
# keep this fully off; the route still records feedback durably in Neon, it
# just skips mirroring a Linear issue. LINEAR_TEAM_ID is a team id (uuid), not
# the short key like "DOR". LINEAR_FEEDBACK_PROJECT_ID and the two label ids
# are optional refinements — unset just means "no project"/"no label".
LINEAR_API_KEY=""
LINEAR_TEAM_ID=""
LINEAR_FEEDBACK_PROJECT_ID=""
LINEAR_BUG_LABEL_ID=""
LINEAR_FEATURE_LABEL_ID=""
