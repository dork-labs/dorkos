{
  "name": "@dorkos/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev --turbopack --port ${SITE_PORT:-6244}",
    "build": "next build && node scripts/upload-sourcemaps.mjs",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:api-docs": "node scripts/generate-api-docs.ts",
    "site:indexnow": "node scripts/indexnow-ping.mjs",
    "db:check": "bash ../../scripts/assert-migrations-current.sh 'apps/site:drizzle.public.config.ts:drizzle-public:db:generate:public' 'apps/site:drizzle.control-plane.config.ts:drizzle-control-plane:db:generate:control-plane'",
    "db:generate:public": "drizzle-kit generate --config drizzle.public.config.ts",
    "db:generate:control-plane": "drizzle-kit generate --config drizzle.control-plane.config.ts",
    "db:migrate": "tsx scripts/baseline-migrations.ts && drizzle-kit migrate --config drizzle.public.config.ts && drizzle-kit migrate --config drizzle.control-plane.config.ts",
    "db:verify-event-capacity": "tsx scripts/verify-managed-event-capacity-cutover.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.5",
    "@dorkos/connector-providers": "workspace:*",
    "@dorkos/icons": "workspace:*",
    "@dorkos/marketplace": "workspace:*",
    "@dorkos/shared": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.9.8",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.15",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-openapi": "^11",
    "fumadocs-ui": "^16.15",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "1.47.0",
    "motion": "^12.43.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.434.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^3.0.6",
    "resend": "^6.28.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.5",
    "@better-fetch/fetch": "1.3.2",
    "@eslint/js": "^10.0.1",
    "@posthog/cli": "^0.18.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
