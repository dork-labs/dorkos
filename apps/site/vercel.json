{
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "buildCommand": "pnpm db:migrate && pnpm exec turbo run build --filter=@dorkos/site",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "**/site-*": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/event-retention",
      "schedule": "0 * * * *"
    }
  ]
}
