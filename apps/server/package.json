  "name": "@dorkos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./harness-boot": "./src/harness-boot.ts",
    "./services/runtimes/claude-code": "./src/services/runtimes/claude-code/index.ts",
    "./services/runtimes/claude-code/auth-probe": "./src/services/runtimes/claude-code/tooling/claude-cli-auth.ts",
    "./services/session": "./src/services/session/index.ts",
    "./services/rooms": "./src/services/rooms/index.ts",
    "./services/canvas": "./src/services/canvas/index.ts",
    "./services/search": "./src/services/search/index.ts",
