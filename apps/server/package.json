    "./services/heartbeats/beat-prompt": "./src/services/heartbeats/beat-prompt.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:tunnel": "TUNNEL_ENABLED=true tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/core-extensions','dist/core-extensions',{recursive:true})\"",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "census:update": "UPDATE_ROUTE_CENSUS=1 vitest run src/http/__tests__/route-census.test.ts",
    "migrate:claude-memory": "tsx src/scripts/migrate-claude-memory.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spaces.json",
    "lint": "eslint ."
  },
