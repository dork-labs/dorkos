    "./services/connectors": "./src/services/connectors/index.ts",
    "./services/core/capabilities": "./src/services/core/capabilities/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:tunnel": "TUNNEL_ENABLED=true tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/core-extensions','dist/core-extensions',{recursive:true})\"",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
