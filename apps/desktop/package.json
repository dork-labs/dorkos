{
  "name": "@dorkos/desktop",
  "version": "0.73.0",
  "description": "DorkOS desktop app - all your coding agents in one place",
  "author": "Dorian Collier",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsx scripts/check-renderer-defines.ts && tsx scripts/build-server.ts",
    "preview": "electron-vite preview",
    "pack": "tsx scripts/rebuild-natives.ts && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "tsx scripts/rebuild-natives.ts && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.224",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.224",
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2",
    "@ngrok/ngrok-darwin-arm64": "1.7.0",
    "@ngrok/ngrok-win32-x64-msvc": "1.7.0",
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.147.0-darwin-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.147.0-win32-x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.224",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@dorkos/db": "workspace:*",
    "@dorkos/server": "workspace:*",
    "@dorkos/shared": "workspace:*",
    "@ngrok/ngrok": "^1.7.0",
    "@openai/codex": "0.147.0",
    "@openai/codex-sdk": "~0.147.0",
    "@opencode-ai/sdk": "^1.18.15",
    "@scalar/express-api-reference": "^0.10.16",
    "better-sqlite3": "^12.11.1",
    "conf": "^15.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "node-pty": "^1.1.0",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dorkos/client": "workspace:*",
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
