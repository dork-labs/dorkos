{
  "name": "@dorkos/monorepo",
  "private": true,
  "version": "0.141.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "dotenv -- turbo dev --filter=!@dorkos/desktop --filter=!@dorkos/community --filter=!@dorkos/design-system",
    "dev:community": "pnpm --filter @dork-labs/cloud-api build && pnpm --filter @dork-labs/connector-providers build && pnpm --filter @dorkos/shared build && pnpm --filter @dorkos/decisions build && dotenv -- concurrently --names api,web --kill-others \"pnpm --filter @dorkos/community dev\" \"pnpm --filter @dorkos/community dev:web\"",
    "dev:desktop": "dotenv -- turbo dev --filter=@dorkos/desktop",
    "dev:dogfood": "concurrently --names preview,cockpit --prefix-colors cyan,magenta --kill-others \"pnpm dev\" \"pnpm cli:dev\"",
    "build": "bash scripts/heavy-run-lock.sh --job dotenv -- turbo build",
    "test": "VITEST_MAX_WORKERS=$(sh scripts/local-vitest-workers.sh) bash scripts/heavy-run-lock.sh --tests dotenv -- turbo test",
    "typecheck": "bash scripts/heavy-run-lock.sh --job dotenv -- turbo typecheck",
    "verify": "node scripts/verify-proof/cli.ts run",
    "verify:checks": "pnpm test:scripts && pnpm lint:root && export TURBO_SCM_BASE=\"$(git rev-parse --verify --quiet origin/main || echo main)\" && export VITEST_MAX_WORKERS=$(sh scripts/local-vitest-workers.sh) && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=8192\" bash scripts/heavy-run-lock.sh --job turbo run typecheck lint --affected --summarize && bash scripts/heavy-run-lock.sh --tests turbo run test --affected --summarize --concurrency=1 -- --run",
    "verify:preopen": "node scripts/verify-proof/cli.ts run-preopen",
    "verify:preopen:turbo": "export TURBO_SCM_BASE=\"$(git rev-parse --verify --quiet origin/main || echo main)\" && export VITEST_MAX_WORKERS=$(sh scripts/local-vitest-workers.sh) && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=8192\" bash scripts/heavy-run-lock.sh --job turbo run typecheck lint --affected --summarize",
    "test:scripts": "bash scripts/run-scripts-suites.sh",
    "heavy": "bash scripts/heavy-run-lock.sh --job",
    "start": "dotenv -- pnpm --filter=@dorkos/server run start",
    "lint": "turbo lint",
    "lint:root": "eslint .",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "evals": "pnpm --filter @dorkos/evals run evals --",
    "evals:local": "pnpm --filter @dorkos/evals run evals -- --suite core --tier claude-code-cheap --isolation child-process --budget 2",
    "evals:sweep": "pnpm --filter @dorkos/evals run sweep",
    "doctor:dev": "tsx packages/cli/scripts/doctor-dev.ts",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check:knip": "node scripts/check-knip.ts",
    "q3:contention": "tsx scripts/q3-contention/run.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "docs:export-api": "tsx scripts/export-openapi.ts",
    "codex:protocol-snapshot": "tsx scripts/codex-protocol-snapshot.ts",
    "docs:runtime-capabilities": "tsx scripts/generate-runtime-capabilities.ts",
    "check:banned-words": "bash scripts/check-banned-words.sh",
    "check:boundary": "tsx scripts/check-boundary.ts",
    "check:max-lines": "node scripts/check-max-lines.ts",
    "check:own-mocks": "node scripts/check-own-mocks.ts",
    "check:turn-port": "node scripts/turn-port/check-turn-port-boundary.ts",
    "check:computer-wall": "node scripts/computer-wall/check-computer-wall.ts",
    "check:api-lint": "node scripts/api-lint/check-api-lint.ts",
    "check:test-ratio": "node scripts/test-ratio/check-test-ratio.ts",
    "check:design-tokens": "node scripts/check-design-tokens.ts",
    "check:dead-doc-paths": "bash scripts/check-dead-doc-paths.sh",
    "check:vocab-gate": "tsx scripts/check-vocab-gate.ts",
    "check:copy-length": "tsx scripts/check-copy-length.ts",
    "check:one-shot-routes": "tsx scripts/check-one-shot-routes.ts",
    "check:copy-spec-drift": "tsx scripts/check-copy-spec-drift.ts",
    "check:config-migration": "tsx scripts/config-migration/check-config-migration.ts",
    "check:chromium-age": "node scripts/release-checks/chromium-age.ts",
    "ci:census": "node packages/ci-steward/src/cli.ts census",
    "ci:ledger-check": "node packages/ci-steward/src/cli.ts ledger-check",
    "ci:ledger-new": "node packages/ci-steward/src/cli.ts ledger-new",
    "ci:status": "node packages/ci-steward/src/cli.ts status",
    "ci:pulse": "node packages/ci-steward/src/cli.ts pulse",
    "ci:report": "node packages/ci-steward/src/cli.ts daily-report",
    "ci:local-export": "node packages/ci-steward/src/cli.ts local-export",
    "ci:flaky": "node packages/ci-steward/src/cli.ts flaky",
    "ci:quarantine": "node packages/ci-steward/src/cli.ts quarantine",
    "measure:agent-hours": "tsx scripts/measure-agent-hours.ts",
    "search:bench": "DORKOS_SEARCH_BENCH=1 tsx scripts/search-corpus-bench.ts",
    "search:latency": "DORKOS_SEARCH_BENCH=1 tsx scripts/search-latency-bench.ts",
    "search:write-through": "DORKOS_SEARCH_BENCH=1 tsx scripts/search-write-through-bench.ts",
    "test:browser": "bash scripts/heavy-run-lock.sh --job dotenv -- turbo run e2e --filter=@dorkos/e2e --only",
    "test:browser:ui": "dotenv -- turbo run e2e:ui --filter=@dorkos/e2e --only",
    "prepare": "lefthook install",
    "smoke:docker": "rm -f dorkos-*.tgz && pnpm --filter=dorkos run build && cd packages/cli && pnpm pack --pack-destination ../../ && cd ../.. && docker build --target smoke -t dorkos-smoke . && docker run --rm dorkos-smoke",
    "smoke:integration": "rm -f dorkos-*.tgz && pnpm --filter=dorkos run build && cd packages/cli && pnpm pack --pack-destination ../../ && cd ../.. && docker build --target integration -t dorkos-integration . && docker run --rm dorkos-integration",
    "smoke:npm": "docker build --target integration --build-arg INSTALL_MODE=npm --build-arg DORKOS_VERSION=${DORKOS_VERSION:-latest} -t dorkos-integration:npm . && docker run --rm dorkos-integration:npm",
    "docker:build": "rm -f dorkos-*.tgz && pnpm --filter=dorkos run build && cd packages/cli && pnpm pack --pack-destination ../../ && cd ../.. && docker build --target runtime -t dorkos .",
    "docker:run": "docker run --rm -p 4242:4242 -e ANTHROPIC_API_KEY -v dorkos-data:/home/node/.dork dorkos",
    "publish:cli": "tsx packages/cli/scripts/release-cli.ts --publish",
    "release:cli:prepare": "tsx packages/cli/scripts/release-cli.ts",
    "release:dispatch": "tsx packages/cli/scripts/release-gate/release-dispatch.ts",
    "release:tag": "tsx packages/cli/scripts/release-gate/release-tag.ts",
    "publish:cloud-api": "tsx packages/cli/scripts/release-gate/publish-package.ts @dork-labs/cloud-api",
    "publish:connector-providers": "tsx packages/cli/scripts/release-gate/publish-package.ts @dork-labs/connector-providers",
    "cli:dev": "pnpm --filter=./packages/cli run build && node packages/cli/dist/bin/cli.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.23.15",
    "turbo": "2.10.13",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-model": "1.25.11",
      "prosemirror-state": "1.4.4",
      "prosemirror-view": "1.42.3",
      "@better-auth/utils": "0.5.0",
      "@anthropic-ai/claude-agent-sdk": "0.3.304",
      "@types/node": "^24",
      "@anthropic-ai/sdk": "0.123.0",
      "@modelcontextprotocol/sdk": "1.32.0",
      "lucide-react": "1.48.0",
      "@vitejs/plugin-react": "5.2.0",
      "drizzle-orm": "0.45.3",
      "eslint-plugin-react-hooks": "7.1.1",
      "vite@7": "7.3.7",
      "@vercel/cli-config>zod": "^4.6.6",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "lodash-es": "^4.18.1",
      "dompurify": "^3.4.17",
      "hono": "^4.13.9",
      "axios": "^1.15.1",
      "fast-uri": "^3.1.9",
      "undici": "^7.30.0",
      "form-data": "^4.0.6",
      "tar": "^7.5.21",
      "tmp": "^0.2.6",
      "@xmldom/xmldom": "^0.8.13",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2",
      "fflate@0.4": "^0.4.9",
      "nanoid@5": "^5.1.16",
      "uuid@11": "^11.1.1",
      "linkify-it": "^5.0.2",
      "ip-address": "^10.7.1",
      "qs": "^6.16.1",
      "body-parser": "^2.3.0",
      "@babel/core": "^7.29.6",
      "jose": "^6.2.10",
      "@simplewebauthn/server>@peculiar/asn1-schema": "2.11.0",
      "smtp-server>nodemailer": "10.1.4"
    },
    "onlyBuiltDependencies": [
      "@posthog/cli",
      "better-sqlite3",
      "esbuild",
      "electron",
      "lefthook",
      "node-pty",
      "sharp",
      "protobufjs",
      "unrs-resolver",
      "core-js"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller",
      "ffmpeg-static"
    ],
    "patchedDependencies": {
      "when-exit@2.1.5": "patches/when-exit@2.1.5.patch"
    }
  }
}
