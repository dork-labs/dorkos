{
  "name": "@dorkos/relay",
  "version": "0.0.0",
  "description": "Foundational inter-agent message bus — NATS-style subject matching, Maildir persistence, SQLite indexing, and pluggable channel adapters.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./approver-allowlist": {
      "types": "./src/adapters/approver-allowlist.ts",
      "default": "./dist/adapters/approver-allowlist.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-adapter-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@chat-adapter/telegram": "^4.38.1",
    "@dorkos/db": "workspace:*",
    "@dorkos/shared": "workspace:*",
    "@grammyjs/auto-retry": "^2.0.2",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "chat": "^4.38.1",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "slackify-markdown": "^5.0.0",
    "ulidx": "^2.4.1",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "vitest": "^4.1.11"
  }
}
