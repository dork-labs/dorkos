{
  "name": "@dorkos/decisions",
  "version": "0.0.0",
  "description": "Bridges behind the DecisionModel port (built-in rules, OpenAI-compatible chat, Jev) and the ladder that runs them: rules first, then a decision model, then a frontier model, then a person.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dorkos/shared": "workspace:*"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/test-utils": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "@types/node": "^24",
    "vitest": "^4.1.10"
  }
}
