{
  "name": "@dork-labs/ui",
  "version": "0.1.0",
  "description": "Shared visual foundations for DorkOS interfaces",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "tokens.css",
    "tailwind.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./tokens.css",
    "./tailwind.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "default": "./dist/label.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "default": "./dist/separator.js"
    },
    "./notice": {
      "types": "./dist/notice.d.ts",
      "default": "./dist/notice.js"
    },
    "./touch-target": {
      "types": "./dist/touch-target.d.ts",
      "default": "./dist/touch-target.js"
    },
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "jsdom": "^27.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dork-labs/dorkos.git",
    "directory": "packages/ui"
  }
}
