        "windows": {
          "five_hour": { "usedPct": 20, "resetsAt": "2026-09-26T19:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:59:00.000Z", "source": "statusline" },
          "seven_day": { "usedPct": 45, "resetsAt": "2026-09-29T16:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:59:00.000Z", "source": "statusline" }
        }
      },
      "expected": { "effectiveReservePct": 50, "fiveHourRoom": true, "weeklyRoom": true }
    },
    {
      "name": "main at its reserve has no weekly room",
      "input": {
        "now": "2026-09-26T16:00:00.000Z",
