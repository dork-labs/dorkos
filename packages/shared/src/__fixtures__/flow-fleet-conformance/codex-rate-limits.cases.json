            "resetsAt": "2026-09-26T19:00:00.000Z",
            "windowMinutes": 300,
            "status": "rejected",
            "observedAt": "2026-09-26T16:00:00.000Z",
            "source": "rollout"
          },
          {
            "key": "seven_day",
            "usedPct": 30,
            "resetsAt": "2026-10-02T00:00:00.000Z",
            "windowMinutes": 10080,
            "status": null,
            "observedAt": "2026-09-26T16:00:00.000Z",
            "source": "rollout"
          }
        ]
      }
    },
    {
