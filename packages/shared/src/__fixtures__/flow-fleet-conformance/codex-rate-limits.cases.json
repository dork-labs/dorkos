        "rateLimits": {
          "limit_id": "codex",
          "primary": {"used_percent": 100, "window_minutes": 300, "resets_at": 1790449200},
          "secondary": {"used_percent": 30, "window_minutes": 10080, "resets_at": 1790899200},
