        "rateLimits": {
          "primary": {"used_percent": 97, "window_minutes": 10080, "resets_at": null},
          "secondary": {"used_percent": 97, "window_minutes": 300, "resets_at": null},
          "rate_limit_reached_type": "rate_limit_reached"
        }
      },
      "expected": {
        "observations": [
