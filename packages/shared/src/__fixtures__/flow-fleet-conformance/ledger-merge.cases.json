        "runtime": "claude-code",
        "accountId": "claude3",
        "now": "2026-09-26T16:04:11.000Z",
        "observations": [
          {
            "key": "five_hour",
            "usedPct": 41.5,
            "resetsAt": "2026-09-26T19:00:00.000Z",
            "status": null,
            "observedAt": "2026-09-26T16:04:10.000Z",
            "source": "statusline"
          }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "runtime": "claude-code",
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:04:11.000Z",
          "windows": {
            "five_hour": {
              "usedPct": 41.5,
              "resetsAt": "2026-09-26T19:00:00.000Z",
              "status": null,
              "observedAt": "2026-09-26T16:04:10.000Z",
              "source": "statusline"
            }
          }
        }
      }
