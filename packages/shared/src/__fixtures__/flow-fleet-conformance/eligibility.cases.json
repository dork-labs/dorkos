              "source": "statusline"
            },
            "seven_day": {
              "usedPct": 60,
              "resetsAt": "2026-09-29T16:00:00.000Z",
              "status": null,
              "observedAt": "2026-09-26T15:59:00.000Z",
              "source": "statusline"
            }
          }
