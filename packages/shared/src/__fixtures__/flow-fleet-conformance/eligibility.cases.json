              "status": "rejected",
              "observedAt": "2026-09-26T15:59:00.000Z",
              "source": "error"
            }
          }
        }
      },
      "expected": {"room": true, "spendRoom": null}
    },
    {
      "name": "a rate-limit error with no resetsAt stops blocking after an hour",
      "input": {
        "now": "2026-09-26T16:00:00.000Z",
        "runtime": "opencode",
        "policy": {"role": "rotation", "reservePct": 0, "spendDownWindowHours": 24, "scope": {"repos": []}},
        "ledger": {
          "windows": {
            "rate_limit:openrouter": {
              "usedPct": null,
              "resetsAt": null,
              "status": "rejected",
              "observedAt": "2026-09-26T14:59:59.000Z",
              "source": "error"
