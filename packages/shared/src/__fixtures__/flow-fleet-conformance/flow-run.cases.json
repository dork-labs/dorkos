{
  "contract": "fleet",
  "about": "Reading <main checkout>/.dork/flow/flow-state.json, a map of issue id to FlowRun (spec flow-cli-core 1.3). input.state is the parsed file. expected.valid says whether the whole file passes the FlowRun schema; expected.readBack is what a reader returns: the records unchanged, unknown fields included, when valid, and {} when any record is invalid (the reader is all-or-nothing). 'account', 'host' and 'runtime' are optional strings. 'host' is a bare string (cli, dorkos or cmux today) and 'runtime' is a bare string (claude-code, codex or opencode today), so a record from a future launcher or runtime still reads. 'account' is an id in that runtime's registry. 'checkpointAt', 'checkpointSha', 'drain' and 'limit' are flow's own optional fields (spec flow-handoff-dispatch 4.3 and 5.1); DorkOS need not read them, but a writer must keep them, like any unknown field. When input.write is present, it is one FlowRun upserted by its issueId through the read-modify-write store, and expected.readBack is the file afterwards: unknown fields on every other record must survive.",
  "cases": [
    {
      "name": "a minimal record reads back unchanged",
      "input": {
        "state": {
          "issue-1": {
            "issueId": "issue-1",
            "identifier": "ABC-1",
            "sessionId": "s-1",
            "worktreePath": "/work/ABC-1",
            "branch": "abc-1",
            "stage": "execute",
            "status": "running",
            "attemptCount": 0,
            "workerPid": 4242,
            "startedAt": "2026-09-26T16:00:00.000Z"
          }
        }
      },
      "expected": {
        "valid": true,
        "readBack": {
          "issue-1": {
            "issueId": "issue-1",
            "identifier": "ABC-1",
            "sessionId": "s-1",
            "worktreePath": "/work/ABC-1",
            "branch": "abc-1",
            "stage": "execute",
            "status": "running",
            "attemptCount": 0,
            "workerPid": 4242,
            "startedAt": "2026-09-26T16:00:00.000Z"
