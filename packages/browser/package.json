{
  "name": "@dorkos/browser",
  "version": "0.0.0",
  "description": "Private managed-browser engine contracts and fixture lifecycle.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime-installation": {
      "types": "./src/runtime/installation/index.ts",
      "default": "./dist/runtime/installation/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:fixture": "pnpm build && vitest run --config vitest.fixture.config.ts"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
