{
  "name": "@dorkos/connector-providers",
  "version": "0.0.0",
  "description": "Confined external connector SDK adapters shared by DorkOS runtimes and hosted services.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./composio": {
      "types": "./src/composio/index.ts",
      "default": "./dist/composio/index.js"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@composio/core": "0.18.1",
    "@dorkos/shared": "workspace:*"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "@types/node": "^24",
    "vitest": "^4.1.11"
  }
}
