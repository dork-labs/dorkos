{
  "name": "@dorkos/a2a-gateway",
  "version": "0.0.0",
  "description": "A2A protocol gateway — exposes DorkOS agents as A2A-compliant endpoints, generating Agent Cards from the Mesh registry and bridging to Relay.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.0",
    "@dorkos/db": "workspace:*",
    "@dorkos/mesh": "workspace:*",
    "@dorkos/relay": "workspace:*",
    "@dorkos/shared": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@dorkos/eslint-config": "workspace:*",
    "@dorkos/test-utils": "workspace:*",
    "@dorkos/typescript-config": "workspace:*",
    "vitest": "^4.1.11"
  }
}
